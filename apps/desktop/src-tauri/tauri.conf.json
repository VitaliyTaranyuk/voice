{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice",
  "version": "0.1.3",
  "identifier": "com.voice.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voice",
        "width": 360,
        "height": 240,
        "minWidth": 320,
        "minHeight": 200,
        "maxHeight": 720,
        "resizable": true,
        "center": true,
        "visible": true,
        "decorations": false,
        "transparent": false,
        "shadow": true
      },
      {
        "label": "overlay",
        "title": "Voice Overlay",
        "url": "overlay.html",
        "width": 160,
        "height": 160,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false
      },
      {
        "label": "history",
        "title": "Voice History",
        "url": "history.html",
        "width": 420,
        "height": 520,
        "resizable": true,
        "minWidth": 360,
        "minHeight": 400,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "skipTaskbar": false
      },
      {
        "label": "settings",
        "title": "Voice Settings",
        "url": "settings.html",
        "width": 460,
        "height": 560,
        "resizable": true,
        "minWidth": 380,
        "minHeight": 420,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzQThDODY2NDc3RDM2N0MKUldSOE5uMUhac2lvTXdqdldhc05pVUNLT3N2TUg0V3RXTmJuMFNqanhXc2xaU0N6QVo5SVBmelUK",
      "endpoints": [
        "https://github.com/VitaliyTaranyuk/voice/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/voice-api/**/*"],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "both",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Voice"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
