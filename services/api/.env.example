# Voice API
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# local (default, no VPN) | auto | groq | openai | deepgram
ASR_PROVIDER=local
# Balance: small. Faster: base · Quality: medium | large-v3
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_DEVICE=cuda
LOCAL_WHISPER_COMPUTE_TYPE=float16
# CUDA 12 DLLs come from nvidia-*-cu12 wheels (see pyproject) — no system toolkit required.
# Desktop: refine on by default. Set VOICE_SKIP_REFINE=1 on the Tauri process to skip DeepSeek.
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
