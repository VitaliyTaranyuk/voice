# Copied to runtime.env next to voice-api.exe by scripts/build-release.ps1.
#
# Non-secret settings only. API keys are NOT stored here and are not shipped in the
# installer: the user enters them in Settings, Windows Credential Manager keeps them,
# and the desktop app passes them to this process as environment variables at startup.
# Environment variables outrank this file in pydantic-settings, so they win.

ASR_PROVIDER=local
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_DEVICE=auto
LOCAL_WHISPER_COMPUTE_TYPE=float16
